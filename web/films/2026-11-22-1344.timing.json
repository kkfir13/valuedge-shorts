 1241}, {"w": "New", "f": 1242, "e": 1248}, {"w": "Year", "f": 1249, "e": 1257}, {"w": "can", "f": 1257, "e": 1264}, {"w": "cut", "f": 1264, "e": 1270}, {"w": "your", "f": 1271, "e": 1279}, {"w": "tax", "f": 1280, "e": 1286}, {"w": "bill.", "f": 1287, "e": 1296}]}, {"a": 1313, "b": 1457, "text": "Eleven months of pride. It took the taxman to make them admit it.", "words": [{"w": "Eleven", "f": 1315, "e": 1326}, {"w": "months", "f": 1327, "e": 1338}, {"w": "of", "f": 1339, "e": 1343}, {"w": "pride.", "f": 1344, "e": 1355}, {"w": "It", "f": 1356, "e": 1360}, {"w": "took", "f": 1361, "e": 1369}, {"w": "the", "f": 1370, "e": 1376}, {"w": "taxman", "f": 1376, "e": 1388}, {"w": "to", "f": 1388, "e": 1393}, {"w": "make", "f": 1394, "e": 1401}, {"w": "them", "f": 1402, "e": 1410}, {"w": "admit", "f": 1411, "e": 1420}, {"w": "it.", "f": 1421, "e": 1427}]}]}