": 1353}, {"w": "notes", "f": 1354, "e": 1363}, {"w": "have", "f": 1364, "e": 1371}, {"w": "lost", "f": 1372, "e": 1379}, {"w": "half", "f": 1380, "e": 1388}, {"w": "their", "f": 1388, "e": 1397}, {"w": "value.", "f": 1398, "e": 1409}]}, {"a": 1425, "b": 1622, "text": "Law flees France. Nobody had been paying for the company. It was paying for itself, in paper.", "words": [{"w": "Law", "f": 1427, "e": 1434}, {"w": "flees", "f": 1434, "e": 1444}, {"w": "France.", "f": 1445, "e": 1458}, {"w": "Nobody", "f": 1459, "e": 1470}, {"w": "had", "f": 1471, "e": 1478}, {"w": "been", "f": 1478, "e": 1486}, {"w": "paying", "f": 1487, "e": 1499}, {"w": "for", "f": 1499, "e": 1506}, {"w": "the", "f": 1506, "e": 1513}, {"w": "company.", "f": 1513, "e": 1528}, {"w": "It", "f": 1529, "e": 1534}, {"w": "was", "f": 1534, "e": 1541}, {"w": "paying", "f": 1541, "e": 1553}, {"w": "for", "f": 1553, "e": 1560}, {"w": "itself,", "f": 1560, "e": 1574}, {"w": "in", "f": 1575, "e": 1579}, {"w": "paper.", "f": 1580, "e": 1591}]}]}