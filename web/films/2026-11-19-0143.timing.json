, "e": 954}, {"w": "at", "f": 955, "e": 959}, {"w": "the", "f": 959, "e": 965}, {"w": "fair,", "f": 966, "e": 975}, {"w": "but", "f": 976, "e": 982}, {"w": "it", "f": 982, "e": 987}, {"w": "still", "f": 987, "e": 996}, {"w": "gives", "f": 997, "e": 1006}, {"w": "milk.", "f": 1007, "e": 1016}]}, {"a": 1023, "b": 1196, "text": "At the bottom, dividends paid almost fourteen percent of the price, and you reinvest every check.", "words": [{"w": "At", "f": 1025, "e": 1030}, {"w": "the", "f": 1030, "e": 1037}, {"w": "bottom,", "f": 1037, "e": 1050}, {"w": "dividends", "f": 1051, "e": 1067}, {"w": "paid", "f": 1067, "e": 1075}, {"w": "almost", "f": 1076, "e": 1087}, {"w": "fourteen", "f": 1087, "e": 1102}, {"w": "percent", "f": 1102, "e": 1115}, {"w": "of", "f": 1116, "e": 1120}, {"w": "the", "f": 1121, "e": 1127}, {"w": "price,", "f": 1127, "e": 1138}, {"w": "and", "f": 1139, "e": 1145}, {"w": "you", "f": 1146, "e": 1152}, {"w": "reinvest", "f": 1152, "e": 1167}, {"w": "every", "f": 1167, "e": 1177}, {"w": "check.", "f": 1177, "e": 1188}]}, {"a": 1196, "b": 1339, "text": "Meanwhile, everything gets cheaper. Living costs fall over eighteen percent.", "words": [{"w": "Meanwhile,", "f": 1198, "e": 1216}, {"w": "everything", "f": 1217, "e": 1236}, {"w": "gets", "f": 1236, "e": 1244}, {"w": "cheaper.", "f": 1245, "e": 1260}, {"w": "Living", "f": 1261, "e": 1272}, {"w": "costs", "f": 1273, "e": 1283}, {"w": "fall", "f": 1283, "e": 1291}, {"w": "over", "f": 1292, "e": 1300}, {"w": "eighteen", "f": 1301, "e": 1316}, {"w": "percent.", "f": 1316, "e": 1332}]}, {"a": 1339, "b": 1441, "text": "Every dollar buys more bread, more cloth, more shares.", "words": [{"w": "Every", "f": 1341, "e": 1350}, {"w": "dollar", "f": 1350, "e": 1361}, {"w": "buys", "f": 1361, "e": 1369}, {"w": "more", "f": 1369, "e": 1377}, {"w": "bread,", "f": 1377, "e": 1388}, {"w": "more", "f": 1388, "e": 1396}, {"w": "cloth,", "f": 1396, "e": 1407}, {"w": "more", "f": 1407, "e": 1415}, {"w": "shares.", "f": 1415, 