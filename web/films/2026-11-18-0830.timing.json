{"w": "Suddenly", "f": 1539, "e": 1552}, {"w": "the", "f": 1553, "e": 1559}, {"w": "company", "f": 1560, "e": 1572}, {"w": "agrees", "f": 1573, "e": 1584}, {"w": "to", "f": 1584, "e": 1588}, {"w": "pay", "f": 1589, "e": 1595}, {"w": "out", "f": 1596, "e": 1602}, {"w": "seventy", "f": 1602, "e": 1615}, {"w": "dollars", "f": 1616, "e": 1628}, {"w": "a", "f": 1629, "e": 1631}, {"w": "share.", "f": 1632, "e": 1643}]}, {"a": 1654, "b": 1778, "text": "The money was never hidden. It was just filed under boring.", "words": [{"w": "The", "f": 1656, "e": 1661}, {"w": "money", "f": 1662, "e": 1671}, {"w": "was", "f": 1672, "e": 1677}, {"w": "never", "f": 1678, "e": 1687}, {"w": "hidden.", "f": 1688, "e": 1707}, {"w": "It", "f": 1708, "e": 1712}, {"w": "was", "f": 1713, "e": 1718}, {"w": "just", "f": 1719, "e": 1726}, {"w": "filed", "f": 1727, "e": 1736}, {"w": "under", "f": 1737, "e": 1746}, {"w": "boring.", "f": 1747, "e": 1758}]}]}