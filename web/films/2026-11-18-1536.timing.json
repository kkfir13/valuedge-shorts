976, "e": 987}]}, {"a": 999, "b": 1123, "text": "Each round trip cost about four percent in commissions and spreads.", "words": [{"w": "Each", "f": 1001, "e": 1008}, {"w": "round", "f": 1011, "e": 1015}, {"w": "trip", "f": 1017, "e": 1026}, {"w": "cost", "f": 1029, "e": 1033}, {"w": "about", "f": 1035, "e": 1042}, {"w": "four", "f": 1047, "e": 1049}, {"w": "percent", "f": 1054, "e": 1065}, {"w": "in", "f": 1067, "e": 1070}, {"w": "commissions", "f": 1072, "e": 1086}, {"w": "and", "f": 1088, "e": 1090}, {"w": "spreads.", "f": 1093, "e": 1109}]}, {"a": 1123, "b": 1219, "text": "Before the tolls, Dave kept pace with the market.", "words": [{"w": "Before", "f": 1125, "e": 1134}, {"w": "the", "f": 1135, "e": 1136}, {"w": "tolls,", "f": 1138, "e": 1157}, {"w": "Dave", "f": 1159, "e": 1166}, {"w": "kept", "f": 1168, "e": 1173}, {"w": "pace", "f": 1175, "e": 1184}, {"w": "with", "f": 1186, "e": 1189}, {"w": "the", "f": 1190, "e": 1191}, {"w": "market.", "f": 1193, "e": 1205}]}, {"a": 1219, "b": 1312, "text": "The professors' explanation: overconfidence.", "words": [{"w": "The", "f": 1221, "e": 1222}, {"w": "professors'", "f": 1223, "e": 1238}, {"w": "explanation:", "f": 1240, "e": 1259}, {"w": "overconfidence.", "f": 1271, "e": 1301}]}, {"a": 1312, "b": 1431, "text": "And Pat, who barely traded? Eighteen and a half percent.", "words": [{"w": "And", "f": 1314, "e": 1319}, {"w": "Pat,", "f": 1321, "e": 1333}, {"w": "who", "f": 1334, "e": 1335}, {"w": "barely", "f": 1337, "e": 1346}, {"w": "traded?", "f": 1349, "e": 1362}, {"w": "Eighteen", "f": 1374, "e": 1385}, {"w": "and", "f": 1387, "e": 1390}, {"w": "a", "f": 1392, "e": 1394}, {"w": "half", "f": 1398, "e": 1401}, {"w": "percent.", "f": 1403, "e": 1417}]}, {"a": 1431, "b": 1544, "text": "The market never beat Dave. His phone did.", "words": [{"w": "The", "f": 1433, "e": 1435}, {"w": "market", "f": 1438, "e": 1447}, {"w": "never", "f": 1454, "e": 1461}, {"w": "beat", "f": 1463, "e": 1470}, {"w": "Dave.", "f": 1475, "e": 1483}, {"w": "His", "f": 1497, "e": 1502}, {"w": "phone", "f": 1504, "e": 1511}, {"w": "did.", "f": 1513, "e": 1527}]}]}