into", "f": 1452, "e": 1456}, {"w": "the", "f": 1457, "e": 1458}, {"w": "New", "f": 1462, "e": 1464}, {"w": "York", "f": 1467, "e": 1473}, {"w": "Stock", "f": 1476, "e": 1482}, {"w": "Exchange.", "f": 1484, "e": 1509}, {"w": "Duer", "f": 1518, "e": 1527}, {"w": "never", "f": 1531, "e": 1536}, {"w": "left", "f": 1538, "e": 1544}, {"w": "prison.", "f": 1547, "e": 1563}]}, {"a": 1567, "b": 1715, "text": "He'd borrowed from everybody. So the brokers agreed to trust only each other.", "words": [{"w": "He'd", "f": 1569, "e": 1573}, {"w": "borrowed", "f": 1577, "e": 1582}, {"w": "from", "f": 1584, "e": 1587}, {"w": "everybody.", "f": 1589, "e": 1608}, {"w": "So", "f": 1613, "e": 1618}, {"w": "the", "f": 1619, "e": 1620}, {"w": "brokers", "f": 1622, "e": 1633}, {"w": "agreed", "f": 1636, "e": 1644}, {"w": "to", "f": 1647, "e": 1649}, {"w": "trust", "f": 1651, "e": 1660}, {"w": "only", "f": 1664, "e": 1673}, {"w": "each", "f": 1676, "e": 1680}, {"w": "other.", "f": 1682, "e": 1698}]}]}